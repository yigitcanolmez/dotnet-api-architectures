{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5007",
  "ConnectionStrings": {
    "Default": "Data Source=eventsourcing.db"
  },
  "Projection": {
    "PollIntervalMs": 500
  },
  "Snapshots": {
    "Every": 5
  }
}
