{
  "Urls": "http://localhost:5100",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "ordering",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/api/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "products": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/api/products/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "reservations": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/api/reservations/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payments": {
        "ClusterId": "payment",
        "RateLimiterPolicy": "fixed",
        "Match": { "Path": "/api/payments/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "ordering": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } },
        "Destinations": { "d1": { "Address": "http://localhost:5101" } }
      },
      "inventory": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } },
        "Destinations": { "d1": { "Address": "http://localhost:5102" } }
      },
      "payment": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } },
        "Destinations": { "d1": { "Address": "http://localhost:5103" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "Yarp.ReverseProxy.Health.ActiveHealthCheckMonitor": "Error",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
