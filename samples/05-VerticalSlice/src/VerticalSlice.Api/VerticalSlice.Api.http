@host = http://localhost:5005
@customerId = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
@keyboard = 11111111-1111-1111-1111-111111111111
@mouse = 22222222-2222-2222-2222-222222222222
@monitor = 33333333-3333-3333-3333-333333333333

### Features/Products/ListProducts.cs
GET {{host}}/products

### Features/Products/RestockProduct.cs (sonradan eklenen dilim)
POST {{host}}/products/{{monitor}}/restock
Content-Type: application/json

{ "quantity": 5 }

### Features/Orders/PlaceOrder.cs
# @name placeOrder
POST {{host}}/orders
Content-Type: application/json

{
  "customerId": "{{customerId}}",
  "items": [
    { "productId": "{{keyboard}}", "quantity": 2 },
    { "productId": "{{mouse}}", "quantity": 1 }
  ]
}

### PlaceOrder — ValidationFilter<T> devreye girer (400 ValidationProblem)
POST {{host}}/orders
Content-Type: application/json

{ "customerId": "00000000-0000-0000-0000-000000000000", "items": [ { "productId": "{{keyboard}}", "quantity": 0 } ] }

### PlaceOrder — yetersiz stok (409)
POST {{host}}/orders
Content-Type: application/json

{ "customerId": "{{customerId}}", "items": [ { "productId": "{{monitor}}", "quantity": 999 } ] }

### Features/Orders/GetOrder.cs
GET {{host}}/orders/{{placeOrder.response.body.$.id}}

### Features/Orders/ListOrders.cs
GET {{host}}/orders?customerId={{customerId}}

### Features/Orders/ShipOrder.cs
POST {{host}}/orders/{{placeOrder.response.body.$.id}}/ship

### Features/Orders/CancelOrder.cs — kargolanmış sipariş için 409 beklenir
POST {{host}}/orders/{{placeOrder.response.body.$.id}}/cancel
